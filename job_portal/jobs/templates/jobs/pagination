<!-- Pagination (static example for demonstration) -->
<div class="col-12">
    <div class="text-center">
        <p>Showing 1 to 5 of 20 jobs</p>
    </div>
    <ul class="pagination justify-content-end" id="pagination">
        {% if jobs.has_previous %}
        <li class="page-item" id="prevPage">
            <a class="page-link" href="?page={{ jobs.previous_page_number }}" aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
            </a>
        </li>
        {% else %}
        <li class="page-item d-none" id="prevPage">
            <a class="page-link" href="javascript:void(0)" aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
            </a>
        </li>
        {% endif %}
        {% for page_num in jobs.paginator.page_range %}
        <li class="page-item count-page {% if jobs.number == page_num %}active{% endif %}"><a class="page-link" href="?page={{ page_num }}">{{ page_num }}</a></li>
        {% endfor %}
        {% if jobs.has_next %}
        <li class="page-item" id="nextPage">
            <a class="page-link" href="?page={{ jobs.next_page_number }}" aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
            </a>
        </li>
        {% else %}
        <li class="page-item d-none" id="nextPage">
            <a class="page-link" href="javascript:void(0)" aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
            </a>
        </li>
        {% endif %}
    </ul>
</div>  
<!-- End Pagination -->